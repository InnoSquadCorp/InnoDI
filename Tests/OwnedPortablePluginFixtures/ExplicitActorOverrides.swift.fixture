import InnoDI
final class Payload: Sendable { let number: Int; init(_ n: Int) { number = n } }
final class LocalResult { let leaf: Payload; init(_ leaf: Payload) { self.leaf = leaf } }

@DIContainer(generateOwned: true) struct GraphNeither {
 @Provide(.shared, initialization: .onDemand, factory: { Payload(7) }) var leaf: Payload
 @Provide(.shared, asyncFactory: { (leaf: Payload) async in leaf.number }) var number: Int
}
 nonisolated func checkNeither() async throws {
  let legacy = GraphNeither()
  legacy.prewarm(.leaf)
  let first = legacy.leaf
  let copy = legacy
  precondition(first === copy.leaf && first !== GraphNeither().leaf)
  let legacyNumber = await legacy.number
  precondition(legacyNumber == 7)
  let replacement = Payload(13)
  precondition(GraphNeither(leaf: replacement).leaf === replacement)
  let owner = try await GraphNeither.makeOwned()
  let leaf = owner.container.leaf
  let ownedNumber = try await owner.container.number
  precondition(leaf === owner.container.leaf && ownedNumber == 7)
  await owner.close()
  precondition(owner.container.leaf === leaf)
  let overridden = try await GraphNeither.makeOwned(leaf: replacement)
  precondition(overridden.container.leaf === replacement)
  await overridden.close()
  let sync = GraphNeither.withOverrides({ $0.leaf = replacement }, operation: { LocalResult($0.leaf) })
  let syncThrow = try GraphNeither.withOverrides({ $0.leaf = replacement }, operation: { (g: GraphNeither) throws -> LocalResult in LocalResult(g.leaf) })
  let asyncResult = await GraphNeither.withOverrides({ $0.leaf = replacement }, operation: { (g: GraphNeither) async -> LocalResult in LocalResult(g.leaf) })
  let asyncThrow = try await GraphNeither.withOverrides({ $0.leaf = replacement }, operation: { (g: GraphNeither) async throws -> LocalResult in LocalResult(g.leaf) })
  precondition([sync, syncThrow, asyncResult, asyncThrow].allSatisfy { $0.leaf === replacement })
  print("selection identity/async/override/close passed")
 }

