import InnoDI

struct Service {}
struct Request {}

@DIComponent
@DIContainer(mainActor: true)
struct MainActorContainer {
    @Provide(.input) var config: String

    @Provide(.shared, factory: Service(), concrete: true)
    var service: Service

    @Provide(.transient, factory: Request(), concrete: true)
    var request: Request
}

@DIContainer(mainActor: true)
struct MainActorRootContainer {
    @Provide(.input) var config: String

    @SubContainer(
        scope: .shared,
        with: [\MainActorRootContainer.config]
    )
    var child: MainActorContainer
}

func buildOffActor(
    dependencies: any MainActorContainerDependencies
) {
    _ = MainActorContainer(dependencies: dependencies)
}

func readOffActor(_ container: MainActorContainer) -> String {
    _ = container.service
    _ = container.request
    return container.config
}

func readChildOffActor(
    _ container: MainActorRootContainer
) -> MainActorContainer {
    container.child
}

@main
struct FixtureApp {
    static func main() {}
}
