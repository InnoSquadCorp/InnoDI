import InnoDI

struct Service {}
struct Request {}

@DIContainerRole(role: ContainerRole.component, mainActor: true)
struct MainActorContainer {
    @Input var config: String

    @Provide(.shared, factory: Service())
    var service: Service

    @Provide(.transient, factory: Request())
    var request: Request
}

@DIContainerRole(role: ContainerRole.local, mainActor: true)
struct MainActorRootContainer {
    @Input var config: String

    @SubContainer(
        scope: .shared,
        with: [\MainActorRootContainer.config]
    )
    var child: MainActorContainer
}

func buildOffActor(
    dependencies: any MainActorContainerDependencies
) {
    _ = MainActorContainer(dependencies: dependencies)
}

func readOffActor(_ container: MainActorContainer) -> String {
    _ = container.service
    _ = container.request
    return container.config
}

func readChildOffActor(
    _ container: MainActorRootContainer
) -> MainActorContainer {
    container.child
}

@main
struct FixtureApp {
    static func main() {}
}
