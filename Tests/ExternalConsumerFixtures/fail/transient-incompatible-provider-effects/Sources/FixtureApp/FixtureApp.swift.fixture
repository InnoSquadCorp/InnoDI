import InnoDI

struct Token: Sendable {}

struct Session: Sendable {
    let token: Token
}

struct ProviderSession {
    let token: Provider<Token>
}

@DIContainer
struct SyncTransientConsumerContainer {
    @Provide(.transient, asyncFactory: { () async in
        Token()
    })
    var asyncToken: Token

    @Provide(.transient, factory: { (asyncToken: Token) in
        Session(token: asyncToken)
    })
    var syncSession: Session
}

@DIContainer
struct NonthrowingTransientConsumerContainer {
    @Provide(.transient, asyncFactory: { () async throws -> Token in
        Token()
    })
    var throwingToken: Token

    @Provide(.transient, asyncFactory: { (throwingToken: Token) async in
        Session(token: throwingToken)
    })
    var asyncSession: Session
}

@DIContainer
struct LazyTransientConsumerContainer {
    @Provide(.transient, asyncFactory: { () async in
        Token()
    })
    var lazyToken: Token

    @Provide(.transient, factory: { (lazyToken: Lazy<Token>) in
        Session(token: lazyToken())
    })
    var lazySession: Session
}

@DIContainer
struct ProviderTransientConsumerContainer {
    @Provide(.transient, asyncFactory: { () async in
        Token()
    })
    var providerToken: Token

    @Provide(.transient, factory: { (providerToken: Provider<Token>) in
        ProviderSession(token: providerToken)
    })
    var providerSession: ProviderSession
}

@DIContainer
struct MissingTransientConstructionContainer {
    @Provide(.transient)
    var missingToken: Token
}

@DIContainer
struct WildcardTransientFactoryContainer {
    @Provide(.transient, factory: { (_: Token) in
        Token()
    })
    var wildcardToken: Token
}

@main
struct FixtureApp {
    static func main() {}
}
