import InnoDI
import ShadowKit

@DIContainerRole(role: ContainerRole.local, mainActor: true)
struct AppContainer {
    @Provide(.transient, factory: { 1 })
    var dependency: Int

    @Provide(factory: { (dependency: Provider<Int>) in
        dependency()
    })
    var value: Int

    @Provide(asyncFactory: { () async -> Int in 2 })
    var asyncValue: Int
}

@main
struct FixtureApp {
    static func main() {}
}
