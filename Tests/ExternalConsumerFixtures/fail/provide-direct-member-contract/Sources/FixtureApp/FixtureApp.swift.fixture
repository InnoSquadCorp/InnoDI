import InnoDI

struct Service: Sendable {}
struct Request: Sendable {}
struct OtherRoot {
    var config: Int
}
struct Holder {
    var config: Int
}
struct ConfigService {
    let config: Int
}
protocol OpaqueService: Sendable {}
struct OpaqueServiceImpl: OpaqueService {}
final class ReferenceService {}

@propertyWrapper
struct Box<Value> {
    var wrappedValue: Value
}

@propertyWrapper
struct BoxActor<Value> {
    var wrappedValue: Value
}

@propertyWrapper
struct MainActor<Value> {
    var wrappedValue: Value
}

enum Other {
    @propertyWrapper
    struct Provide {
        var wrappedValue: Int = 0
    }
}

typealias Handler = @Sendable () -> Void

let manualRecovery = false

struct PlainDependencies {
    @Provide(.input)
    var input: String

    @Provide(.shared, factory: Service())
    var service: Service

    @Provide(.transient, factory: Request())
    var request: Request
}

@DIContainer
struct OuterContainer {
    struct NestedDependencies {
        @Provide(.shared, factory: Service())
        var nestedService: Service
    }
}

@DIContainer
struct StaticDependencyContainer {
    @Provide(.input)
    static var staticInput: String { "" }

    @Provide(.transient, factory: { (staticInput: String) in
        staticInput
    })
    var staticEcho: String
}

@DIContainer
struct ForgedAccessor {
    @InnoDI._InnoDIProvideAccessor(recovery: true)
    @Provide(.transient, factory: 42)
    var value: Int

    @InnoDI._InnoDIProvideAccessor(recovery: false)
    @Provide(.shared, factory: 42)
    var sharedValue: Int

    @InnoDI._InnoDIProvideAccessor(recovery: manualRecovery)
    @Provide(.input)
    var inputValue: Int
}

@DIContainer
struct InvalidStorageContainer {
    @Provide(.input)
    let immutable: Int

    @Provide(.shared, factory: 42)
    var computed: Int { 42 }

    @Provide(.shared, factory: 42)
    lazy var lazyValue: Int = 42

    @Provide(.input)
    weak var weakValue: ReferenceService?

    @Provide(.input)
    unowned var unownedValue: ReferenceService

    @Provide(.shared, factory: 42)
    var observed: Int = 0 {
        didSet {}
    }

    @Provide(.input)
    private(set) var restrictedValue: Int

    @Box
    @Provide(.shared, factory: 42)
    var wrappedValue: Int = 0

    @BoxActor
    @Provide(.shared, factory: 42)
    var actorNamedWrapperValue: Int = 0

    @MainActor
    @Provide(.shared, factory: 42)
    var shadowedMainActorValue: Int = 0

    #if os(macOS)
    @Box
    #endif
    @Provide(.shared, factory: 42)
    var conditionalWrapperValue: Int = 0

    @Provide(.shared, factory: 42)
    var inferredValue = 42

}

@DIContainer
struct ConditionalProviderContainer {
    #if os(macOS)
    @Provide(.shared, factory: Service())
    var service: Service
    #endif
}

@DIContainer
struct InvalidConstructionContainer {
    @Provide(.input)
    var config: Int

    @Provide(
        .shared,
        Service.self,
        factory: Service(),
    )
    var conflictingSource: Service

    @Provide(
        .shared,
        with: [\Self.config],
        factory: Service(),
    )
    var invalidWithSource: Service
}

@DIContainer
struct InvalidProvidePathContainer {
    @Provide(.input)
    var config: Int

    @Provide(
        .shared,
        Service.self,
        with: [\OtherRoot.config],
    )
    var foreignRootSource: Service

    @Provide(.input)
    var holder: Holder

    @Provide(
        .shared,
        ConfigService.self,
        with: [\Self.holder.config],
    )
    var nestedPathSource: ConfigService
}

@DIContainer
struct OpaqueProviderContainer {
    @Provide(.shared)
    var service: some OpaqueService = OpaqueServiceImpl()
}

@DIContainer
struct DuplicateProviderContainer {
    @Provide(.shared, factory: 42)
    @Provide(.shared, factory: 42)
    var value: Int = 0
}

struct StandaloneDuplicateProviders {
    @Provide(.input)
    @Provide(.input)
    var standaloneValue: Int

    struct Nested {
        @Provide(.input)
        @Provide(.input)
        var nestedValue: Int
    }
}

@DIContainer
struct ForeignWrapperContainer {
    @Other.Provide
    @Provide(.input)
    var foreignWrappedInput: Int
}

struct ForgedStandaloneRecovery {
    @InnoDI._InnoDIProvideAccessor(recovery: true)
    @Provide(.input)
    var forgedRecoveryInput: Int
}

@DIContainer
struct InvalidEscapingInputContainer {
    @Provide(.input, escaping: true)
    var handler: Optional<Handler>

    @Provide(.input, escaping: true)
    var qualifiedHandler: Swift.Optional<Handler>
}

@DIContainer
struct IUOProviderContainer {
    @Provide(.input)
    var service: Service!
}

@DIContainer
struct LocalDependencyContainer {
    func makeService() {
        @Provide(.shared, factory: Service())
        var localService: Service
        localService = Service()
        localService = Service()
        _ = localService
    }
}

@main
struct FixtureApp {
    static func main() {
        _ = ConditionalProviderContainer()
    }
}
