import InnoDI

@DIContainer
struct DuplicateProviderMemberContainer {
    @Input
    var duplicatedMemberValue: Int

    @Input
    var duplicatedMemberValue: Int
}

@DIContainerRole(role: ContainerRole.local, mainActor: true)
struct DuplicateMainActorProviderMemberContainer {
    @Input
    var duplicatedMainActorMemberValue: Int

    @Input
    var duplicatedMainActorMemberValue: Int
}

@DIContainer
struct DuplicateManagedIdentityChild {}

@DIContainer
struct DuplicateSubContainerMemberContainer {
    @SubContainer(scope: .shared, with: [])
    var duplicatedSubValue: DuplicateManagedIdentityChild

    @SubContainer(scope: .transient, with: [])
    var duplicatedSubValue: DuplicateManagedIdentityChild
}

@DIContainer
struct DuplicateCrossRoleMemberContainer {
    @Input
    var duplicatedCrossRoleValue: Int

    @SubContainer(scope: .shared, with: [])
    var duplicatedCrossRoleValue: DuplicateManagedIdentityChild
}

@DIContainer
struct DuplicateFactoryParameterContainer {
    @Provide(
        .shared,
        factory: { (
            ordinaryDuplicateValue: Int,
            ordinaryDuplicateValue: Int
        ) in 0 },
    )
    var ordinaryConsumer: Int

    @Provide(
        .shared,
        factory: { (
            lazyDuplicateValue: Lazy<Int>,
            lazyDuplicateValue: Lazy<Int>
        ) in 0 },
    )
    var lazyConsumer: Int

    @Provide(
        .shared,
        factory: { (
            providerDuplicateValue: Provider<Int>,
            providerDuplicateValue: Provider<Int>
        ) in 0 },
    )
    var providerConsumer: Int

    @Provide(
        .shared,
        factory: { (
            crossKindDuplicateValue: Int,
            crossKindDuplicateValue: Lazy<Int>
        ) in 0 },
    )
    var crossKindConsumer: Int
}

@DIContainer
struct EscapedProviderIdentifierContainer {
    @Input
    var `default`: Int
}

@DIContainer
struct EscapedFactoryParameterContainer {
    @Provide(
        .shared,
        factory: { (`default`: Int) in 0 },
    )
    var escapedParameterConsumer: Int
}

struct EscapedFeatureContainer {}

@DIContainer
struct EscapedSubContainerIdentifierParent {
    @SubContainer(scope: .shared)
    var `default`: EscapedFeatureContainer
}

@main
struct FixtureApp {
    static func main() {}
}
