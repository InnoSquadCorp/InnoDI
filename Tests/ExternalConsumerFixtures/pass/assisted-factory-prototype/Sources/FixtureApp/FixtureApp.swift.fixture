@_spi(Experimental) import FeatureKit

@main
struct FixtureApp {
    static func main() {
        let repository = TrainingRepository()
        let parent = AppContainer(repository: repository)
        let first = parent.training(routineID: 1)
        let second = parent.training(routineID: 2)

        precondition(first.routineID == 1)
        precondition(second.routineID == 2)
        precondition(first.token !== second.token)
    }
}
