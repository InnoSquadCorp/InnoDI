import InnoDI

struct Seed: Sendable {
    let value: Int
}

struct Endpoint: Sendable {
    let path: String
}

struct Token: Sendable {
    let value: String
}

struct Session: Sendable {
    let token: Token
}

struct Request: Sendable {
    let session: Session
}

@DIContainer
struct AppContainer {
    @Provide(.shared, factory: Seed(value: 42), concrete: true)
    var seed: Seed

    @Provide(.shared, asyncFactory: { (seed: Seed) async in
        Endpoint(path: "/v\(seed.value)")
    }, concrete: true)
    var endpoint: Endpoint

    @Provide(.shared, asyncFactory: { (endpoint: Endpoint) async throws -> Token in
        Token(value: endpoint.path)
    }, concrete: true)
    var token: Token

    @Provide(.shared, asyncFactory: { (token: Token) async throws -> Session in
        Session(token: token)
    }, concrete: true)
    var session: Session

    @Provide(.transient, asyncFactory: { (session: Session) async throws -> Request in
        Request(session: session)
    }, concrete: true)
    var request: Request

    @Provide(.transient, asyncFactory: { (seed: Seed) async in
        Endpoint(path: "/transient/\(seed.value)")
    }, concrete: true)
    var transientEndpoint: Endpoint

    @Provide(.transient, asyncFactory: { (transientEndpoint: Endpoint) async in
        Token(value: transientEndpoint.path)
    }, concrete: true)
    var transientToken: Token

    @Provide(.transient, asyncFactory: { (transientToken: Token) async throws -> Session in
        Session(token: transientToken)
    }, concrete: true)
    var transientSession: Session

    @Provide(.transient, asyncFactory: { (transientSession: Session) async throws -> Request in
        Request(session: transientSession)
    }, concrete: true)
    var transientRequest: Request
}

@main
struct FixtureApp {
    static func main() async throws {
        let container = AppContainer()
        let endpoint: Endpoint = await container.endpoint
        let token: Token = try await container.token
        let session: Session = try await container.session
        let request: Request = try await container.request
        let transientEndpoint: Endpoint = await container.transientEndpoint
        let transientToken: Token = await container.transientToken
        let transientSession: Session = try await container.transientSession
        let transientRequest: Request = try await container.transientRequest

        precondition(endpoint.path == token.value)
        precondition(session.token.value == request.session.token.value)
        precondition(transientEndpoint.path == transientToken.value)
        precondition(transientSession.token.value == transientRequest.session.token.value)
    }
}
