import InnoDI

public struct FeatureConfig: Sendable {
    public init() {}
}

public protocol FeatureServiceProtocol {}

public struct FeatureService: FeatureServiceProtocol {
    public init() {}
}

public struct FeatureRequest: Sendable {
    public let config: FeatureConfig

    public init(config: FeatureConfig) {
        self.config = config
    }
}

public struct AsyncFeatureService: Sendable {
    public init() {}
}

public struct AsyncFeatureRequest: Sendable {
    public init() {}
}

@DIContainerRole(role: ContainerRole.component)
public struct FeatureContainer {
    @Input public var config: FeatureConfig
    @Provide(.shared, factory: FeatureService()) public var service: any FeatureServiceProtocol
    @Provide(.transient, factory: { (config: FeatureConfig) in
        FeatureRequest(config: config)
    })
    public var request: FeatureRequest
}

@DIContainerRole(role: ContainerRole.component)
public struct BindingNameFeatureContainer {
    @Input public var dependencies: Int
    @Input public var applyOverrides: String
}

public enum FeatureNamespace {
    public enum Detail {
        @DIContainerRole(role: ContainerRole.component)
        public struct NestedFeatureContainer {
            @Input public var config: FeatureConfig
        }
    }
}

@DIContainerRole(role: ContainerRole.component, mainActor: true)
public struct MainActorFeatureContainer {
    @Input public var config: FeatureConfig
    @Provide(.shared, factory: FeatureService()) public var service: any FeatureServiceProtocol
    @Provide(.transient, factory: { (config: FeatureConfig) in
        FeatureRequest(config: config)
    })
    public var request: FeatureRequest
    @Provide(.shared, asyncFactory: { () async in AsyncFeatureService() })
    public var asyncService: AsyncFeatureService
    @Provide(.transient, asyncFactory: { () async in AsyncFeatureRequest() })
    public var asyncRequest: AsyncFeatureRequest
}

public enum MainActorFeatureNamespace {
    public enum Detail {
        @DIContainerRole(role: ContainerRole.component, mainActor: true)
        public struct NestedFeatureContainer {
            @Input public var config: FeatureConfig
        }
    }
}

public struct MainActorFeatureScene {
    public let container: MainActorFeatureContainer

    @MainActor
    public init(container: MainActorFeatureContainer) {
        self.container = container
    }
}

@DIContainerRole(role: ContainerRole.root, mainActor: true)
public struct MainActorAppContainer {
    @Input public var config: FeatureConfig

    @SubContainer(
        scope: .shared,
        with: [\MainActorAppContainer.config],
        featureRoot: MainActorFeatureScene.self
    )
    public var feature: MainActorFeatureContainer
}

@DIContainerRole(role: ContainerRole.local, mainActor: true)
public struct MainActorParentWithNonisolatedChild {
    @Input public var config: FeatureConfig

    @SubContainer(
        scope: .shared,
        with: [\MainActorParentWithNonisolatedChild.config]
    )
    public var feature: FeatureContainer
}

public func mountComponent<Component: _InnoDIComponentMountable>(
    _ component: Component.Type,
    dependencies: Component._InnoDIComponentDependencies,
    _ applyOverrides: (inout Component._InnoDIComponentOverrides) -> Void
) -> Component {
    Component(dependencies: dependencies, applyOverrides)
}

@MainActor
public func mountMainActorComponent<
    Component: _InnoDIMainActorComponentMountable
>(
    _ component: Component.Type,
    dependencies: Component._InnoDIComponentDependencies,
    _ applyOverrides: @MainActor (
        inout Component._InnoDIComponentOverrides
    ) -> Void
) -> Component {
    Component(dependencies: dependencies, applyOverrides)
}
