import Contracts
import InnoDI

public struct ModuleAService: CrossModuleService {
    public let name = "a"
    public init() {}
}

public struct ModuleAProviderCatalog {
    public var service: any CrossModuleService

    public init(service: any CrossModuleService) {
        self.service = service
    }
}

public enum ModuleAContributions {
    public static let ordered = DICollectionGroup<any CrossModuleService>([ModuleAService()])
    public static let providerMetadata = DICollectionMetadata.keyedProviders([
        .init(key: "a", contributor: \ModuleAProviderCatalog.service),
    ])

    public static func keyed() throws -> DIKeyedCollection<String, any CrossModuleService> {
        try DIKeyedCollection([.init(key: "a", value: ModuleAService())])
    }

    public static func providers(
        counter: CrossModuleCounter
    ) throws -> DIKeyedProviderCollection<String, any CrossModuleService> {
        try DIKeyedProviderCollection([
            .init(key: "a") {
                counter.increment("a")
                return ModuleAService()
            },
        ])
    }
}
