import Foundation
import InnoDI

protocol RequestInterceptor: AnyObject {
    var name: String { get }
}

final class AuthInterceptor: RequestInterceptor {
    let name = "auth"
}

final class LoggingInterceptor: RequestInterceptor {
    let name = "logging"
}

final class StubInterceptor: RequestInterceptor {
    let name = "stub"
}

struct Client {
    let interceptors: [any RequestInterceptor]
}

final class CreationCounter: @unchecked Sendable {
    private let lock = NSLock()
    private var values = [0, 0]

    func increment(_ index: Int) {
        lock.lock()
        values[index] += 1
        lock.unlock()
    }

    func snapshot() -> [Int] {
        lock.lock()
        defer { lock.unlock() }
        return values
    }
}

let creationCounter = CreationCounter()

@DIContainer
struct NetworkContainer {
    @Provide(.shared, factory: AuthInterceptor())
    var auth: AuthInterceptor

    @Provide(.transient, factory: LoggingInterceptor())
    var logging: LoggingInterceptor

    @Multibinding([\Self.auth, \Self.logging])
    var interceptors: [any RequestInterceptor]

    @Multibinding([])
    var noInterceptors: [any RequestInterceptor]

    @Provide(.transient, factory: { interceptors in
        Client(interceptors: interceptors)
    })
    var client: Client

    @Provide(.transient, factory: {
        creationCounter.increment(0)
        return AuthInterceptor()
    })
    var providerAuth: AuthInterceptor

    @Provide(.transient, factory: {
        creationCounter.increment(1)
        return LoggingInterceptor()
    })
    var providerLogging: LoggingInterceptor

    @Provide(
        .transient,
        collection: .keyedProviders([
            .init(key: "auth", contributor: \Self.providerAuth),
            .init(key: "logging", contributor: \Self.providerLogging),
        ]),
        factory: {
            (
                providerAuth: Provider<AuthInterceptor>,
                providerLogging: Provider<LoggingInterceptor>
            ) in
            let entries = [
                DIKeyedProviderCollection<String, any RequestInterceptor>.Entry(
                    key: "auth",
                    provider: { providerAuth() }
                ),
                .init(key: "logging", provider: { providerLogging() }),
            ]
            return (try? DIKeyedProviderCollection(entries)) ?? .empty
        }
    )
    var keyedProviders: DIKeyedProviderCollection<String, any RequestInterceptor>
}

let container = NetworkContainer()
let first = container.interceptors
let second = container.interceptors
precondition(first.map(\.name) == ["auth", "logging"])
precondition(second.map(\.name) == ["auth", "logging"])
precondition(first[0] === second[0])
precondition(first[1] !== second[1])
precondition(container.client.interceptors.map(\.name) == ["auth", "logging"])
precondition(container.noInterceptors.isEmpty)
let providers = container.keyedProviders
precondition(providers.map(\.key) == ["auth", "logging"])
precondition(creationCounter.snapshot() == [0, 0])
precondition(providers[key: "logging"]?.name == "logging")
precondition(creationCounter.snapshot() == [0, 1])

let stub = StubInterceptor()
let overridden = NetworkContainer { overrides in
    overrides.interceptors = [stub]
}
precondition(overridden.interceptors.count == 1)
precondition(overridden.interceptors[0] === stub)
precondition(overridden.client.interceptors[0] === stub)
