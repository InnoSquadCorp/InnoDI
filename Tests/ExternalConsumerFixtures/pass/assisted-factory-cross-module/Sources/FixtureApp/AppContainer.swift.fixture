import FeatureKit
import InnoDI

@DIContainer
struct AppContainer {
    @Provide(.input)
    var repository: TrainingRepository

    @SubContainerFactory(
        TrainingContainer.self,
        bindings: [
            (
                child: \TrainingContainer.repository,
                parent: \AppContainer.repository
            ),
        ]
    )
    var training: TrainingContainer.AssistedFactory
}
