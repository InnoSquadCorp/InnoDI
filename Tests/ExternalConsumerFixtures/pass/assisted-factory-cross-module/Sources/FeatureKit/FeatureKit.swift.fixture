import InnoDI

public struct TrainingRepository {
    public init() {}
}

public final class InstanceToken {
    public init() {}
}

@DIContainer
public struct TrainingContainer {
    @Input(.assisted) public var routineID: Int
    @Input public var repository: TrainingRepository
    @Provide(.shared, factory: InstanceToken()) public var token: InstanceToken

    @AssistedFactory(
        TrainingContainer.self,
        static: [\TrainingContainer.repository],
        assisted: [\TrainingContainer.routineID]
    )
    public struct AssistedFactory {}
}
