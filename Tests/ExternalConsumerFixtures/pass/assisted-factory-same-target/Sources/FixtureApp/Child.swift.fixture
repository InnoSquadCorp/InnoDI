import InnoDI

final class Repository {}

@MainActor
final class RepositoryFactory {
    private(set) var calls = 0

    func make() -> Repository {
        calls += 1
        return Repository()
    }
}

final class InstanceToken {}
typealias Callback = () -> Void

@DIContainer(mainActor: true)
struct SessionContainer {
    @Input(.assisted) var sessionID: Int
    @Input(.assisted) var completion: () -> Void
    @Input var repository: Repository
    @Input(escaping: true) var callback: Callback
    @Provide(.shared, factory: InstanceToken()) var token: InstanceToken

    @AssistedFactory(
        SessionContainer.self,
        static: [
            \SessionContainer.repository,
            \SessionContainer.callback,
        ],
        assisted: [
            \SessionContainer.sessionID,
            \SessionContainer.completion,
        ]
    )
    struct AssistedFactory {}
}
