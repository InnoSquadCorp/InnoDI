import InnoDI

@DIContainerRole(role: ContainerRole.local, mainActor: true)
struct AppContainer {
    @Input var repositoryFactory: RepositoryFactory
    @Input(escaping: true) var callback: Callback
    @Provide(
        .shared,
        initialization: .onDemand,
        factory: { (repositoryFactory: RepositoryFactory) in
            repositoryFactory.make()
        }
    ) var repository: Repository

    @SubContainerFactory(
        SessionContainer.self,
        bindings: [
            (
                child: \SessionContainer.repository,
                parent: \AppContainer.repository
            ),
            (
                child: \SessionContainer.callback,
                parent: \AppContainer.callback
            ),
        ]
    )
    var session: SessionContainer.AssistedFactory
}
