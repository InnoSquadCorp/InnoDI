import InnoDI

protocol _InnoDIComponentMountable {}
protocol _InnoDIMainActorComponentMountable {}
protocol DIHierarchyRootMarker {}

@DIContainerRole(role: ContainerRole.component)
struct FeatureContainer {
    @Input var value: Int
}

@DIContainerRole(role: ContainerRole.root, mainActor: true)
struct RootContainer {
    @Input var value: Int
}

struct FeatureDependencies: FeatureContainerDependencies {
    let value: Int
}

func requireComponent<Component: InnoDI._InnoDIComponentMountable>(
    _: Component.Type
) {}

@MainActor
func requireMainActorComponent<
    Component: InnoDI._InnoDIMainActorComponentMountable
>(_: Component.Type) {}

func requireRoot<Root: InnoDI.DIHierarchyRootMarker>(_: Root.Type) {}

@main
struct FixtureApp {
    @MainActor
    static func main() {
        requireComponent(FeatureContainer.self)
        requireRoot(RootContainer.self)

        let feature = FeatureContainer(
            dependencies: FeatureDependencies(value: 1)
        )
        let root = RootContainer(value: 2)
        precondition(feature.value == 1)
        precondition(root.value == 2)
    }
}
