import InnoDI

struct Consumer: Sendable { let request: Int }

@DIContainer
struct App {
    @Provide(.transient, asyncFactory: { () async in 1 }) var request: Int
    @Provide(.transient, asyncFactory: { (request: Int) async in Consumer(request: request) }) var consumer: Consumer
}
@main enum Check { static func main() async throws { let value = await App().consumer; precondition(value.request == 1) } }
